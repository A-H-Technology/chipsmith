chipsmith := "cargo run --quiet --manifest-path ../Cargo.toml -p chipsmith-cli --"

_default:
    @just --list

# Run the testbenches. GHDL, per chipsmith.toml — no toolchain, no licence.
testbench:
    {{chipsmith}} test --project-dir .

# Same testbenches on the simulator Quartus bundles (needs an install, and a licence for Questa)
testbench-quartus:
    {{chipsmith}} test --project-dir . --simulator quartus

# Synthesise, fit, assemble and report timing
build:
    {{chipsmith}} build --project-dir .

# Load the last build onto the board over JTAG
flash:
    {{chipsmith}} flash --project-dir .

clean:
    rm -rf build
